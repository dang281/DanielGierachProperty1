const collectiveSold = [
  {
    image: 'https://cdn6.ep.dynamics.net/s3/rw-propertyimages/9517-H3526890-206024564__1781587667-84989-Photo-30-Web.jpg',
    suburb: 'Balmoral',
    address: '27 Taylor Street',
    street: 'Balmoral QLD 4171',
    price: 'Sold July 2026',
    beds: 5, baths: 4, cars: 2,
    href: 'https://raywhitebulimba.com.au/properties/sold-residential/qld/balmoral-4171/house/3526890',
  },
  {
    image: 'https://cdn6.ep.dynamics.net/s3/rw-propertyimages/8758-H3472604-192402385__1773701582-35077-Photo-18-Web.jpg',
