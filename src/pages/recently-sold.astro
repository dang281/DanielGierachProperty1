  },
  {
    image: 'https://cdn6.ep.dynamics.net/s3/rw-propertyimages/7465-H3533026-204892884__1780899293-93591-Photo-2-Web.jpg',
    suburb: 'Hawthorne',
    address: '26 Stewart Street',
    street: 'Hawthorne QLD 4171',
    price: 'Sold July 2026',
    beds: 5, baths: 3, cars: 1,
    href: 'https://raywhitebulimba.com.au/properties/sold-residential/qld/hawthorne-4171/house/3533026',
  },
  {
    image: 'https://cdn6.ep.dynamics.net/s3/rw-propertyimages/3ebf-H3527842-206212560__1781674124-94868-4-web-or-mls-358-hawthorne-rd-4.jpg',
    suburb: 'Hawthorne',
    address: '4/358 Hawthorne Road',
    street: 'Hawthorne QLD 4171',
    price: 'Sold June 2026',
    beds: 3, baths: 2, cars: 2,
    href: 'https://raywhitebulimba.com.au/properties/sold-residential/qld/hawthorne-4171/townhouse/3527842',
  },
  {
    image: 'https://cdn6.ep.dynamics.net/s3/rw-propertyimages/beb1-H3514365-202932930__1779702303-124387-Photo-1-Web.jpg',
    suburb: 'Bulimba',
    address: '99 Bulimba Street',
    street: 'Bulimba QLD 4171',
    price: 'Sold June 2026',
